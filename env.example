# Kopieren nach .env:  cp env.example .env

# Brave Search API Key (https://brave.com/search/api/)
BRAVE_API_KEY=

# Standard-Sprache / -Land der Suche
DEFAULT_LANGUAGE=de
DEFAULT_COUNTRY=de

# Mindestabstand zwischen zwei Suchen in Sekunden (Free-Plan: 1 Anfrage/Sekunde)
MIN_INTERVAL_SECONDS=1.1

# Guthaben-Schätzung für brave_quota: Preis pro Anfrage und Monatsbudget (Free-Credits bzw. Spend-Limit) in USD
BRAVE_COST_PER_REQUEST=0.005
BRAVE_MONTHLY_BUDGET=5.00
# Guthaben-Stand alle N Anfragen ins Log schreiben (0 = aus)
LOG_QUOTA_EVERY=10

# fetch_url: Volltext einzelner Seiten abrufen (false = Tool wird nicht angeboten)
FETCH_ENABLED=true
# Maximale Download-Größe in Bytes und maximale Textlänge pro Antwort in Zeichen
FETCH_MAX_BYTES=2000000
FETCH_MAX_CHARS=20000
FETCH_MAX_REDIRECTS=3
FETCH_ALLOWED_PORTS=80,443
# Zusätzlich gesperrte Netze (CIDR, kommagetrennt), z.B. die öffentliche IP des Hosts
FETCH_BLOCKED_NETWORKS=
# Heuristische Erkennung von Prompt Injection: fügt bei Verdacht das Warnfeld injection_warning hinzu
FETCH_INJECTION_SCAN=true
# Prompt-Injection-Selbsttest: Abruf dieser URL liefert eine harmlose Test-Injection (leer = aus)
# FETCH_INJECTION_TEST_URL=https://injection-test.invalid/artikel
FETCH_INJECTION_TEST_URL=

# Optional: Bearer-Token für den HTTP-Endpunkt (empfohlen, sobald nicht nur lokal erreichbar)
MCP_AUTH_TOKEN=

LOG_LEVEL=INFO
